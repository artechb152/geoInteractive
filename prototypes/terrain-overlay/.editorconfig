root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# שורות בעברית נשברות ידנית לפי משמעות; חיתוך רווחים בסוף שורה שובר
# מעברי שורה מכוונים ב-Markdown
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,webp,avif,ico}]
insert_final_newline = false
trim_trailing_whitespace = false
